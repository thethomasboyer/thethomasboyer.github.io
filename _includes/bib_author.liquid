{%- assign author = include.author -%}
{%- assign equal_contributors = include.equal_contributors -%}
{%- assign author_is_self = false -%}
{%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
{%- assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
{%- assign author_full_name = author.first | append: ' ' | append: author_last_name | strip -%}
{%- assign author_is_equal_contributor = false -%}
{%- for equal_contributor in equal_contributors -%}
  {%- assign equal_contributor_name = equal_contributor | strip -%}
  {%- if equal_contributor_name == author_full_name -%}
    {%- assign author_is_equal_contributor = true -%}
  {%- endif -%}
{%- endfor -%}
{%- if site.scholar.last_name contains author_last_name -%}
  {%- if site.scholar.first_name contains author.first -%}
    {%- assign author_is_self = true -%}
  {%- endif -%}
{%- endif -%}
{%- assign coauthor_url = null -%}
{%- assign clean_last_name = author_last_name | downcase | remove_accents -%}
{%- if site.data.coauthors[clean_last_name] -%}
  {%- for coauthor in site.data.coauthors[clean_last_name] -%}
    {%- if coauthor.firstname contains author.first -%}
      {%- assign coauthor_url = coauthor.url -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- capture author_name -%}{{ author.first }} {{ author_last_html }}{%- endcapture -%}
{%- capture author_label -%}
  {%- if author_is_equal_contributor -%}
    <strong>{{ author_name | strip }}</strong>
  {%- else -%}
    {{ author_name | strip }}
  {%- endif -%}
{%- endcapture -%}
{%- if author_is_self -%}
  <em>{{- author_label | strip -}}</em>
{%- elsif coauthor_url -%}
  <a href="{{ coauthor_url }}">{{- author_label | strip -}}</a>
{%- else -%}
  {{- author_label | strip -}}
{%- endif -%}
